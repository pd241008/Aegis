# Dockerfile.cluster
# Multi-stage build for the Aegis Scala/Akka cluster (the Brain).
# Produces a single self-contained fat jar via sbt-assembly.

FROM eclipse-temurin:17-jdk-jammy AS build

ENV SBT_VERSION=1.9.9
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fL "https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz" | tar xz -C /opt \
    && ln -s "/opt/sbt/bin/sbt" /usr/local/bin/sbt

WORKDIR /build
COPY cluster/ /build/cluster/
COPY proto/ /build/proto/

WORKDIR /build/cluster
RUN sbt -batch assembly

FROM eclipse-temurin:17-jre-jammy

ENV AEGIS_BRAIN_PORT=9090 \
    AEGIS_HTTP_PORT=9091 \
    AEGIS_BUFFER_DIR=/data/buffers \
    AEGIS_BRIEFING_DIR=/data/briefings \
    AEGIS_INCIDENT_DIR=/data/incidents \
    AEGIS_CORR_MIN_AGENTS=2 \
    AEGIS_CORR_WINDOW_MS=10000

RUN useradd -m -u 10001 aegis \
    && mkdir -p /data/buffers /data/briefings /data/incidents \
    && chown -R aegis:aegis /data

COPY --from=build /build/cluster/target/scala-3.3.1/aegis-cluster.jar /opt/aegis/aegis-cluster.jar
RUN chown aegis:aegis /opt/aegis/aegis-cluster.jar

USER aegis
WORKDIR /opt/aegis

EXPOSE 9090 9091

ENTRYPOINT ["java", "-jar", "/opt/aegis/aegis-cluster.jar"]
