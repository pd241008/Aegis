# Copy to deployments/compose.env and adjust as needed:
#   cp deployments/compose.env.example deployments/compose.env
#   docker compose --env-file deployments/compose.env -f deployments/docker-compose.yml up --build

# Agents required to form a correlated incident (default 2)
AEGIS_CORR_MIN_AGENTS=2

# Correlation window in milliseconds (default 10000)
# AEGIS_CORR_WINDOW_MS=10000

# Agent-side anomaly detection thresholds (defaults 95 / 90, streak of 3).
# For smoke tests / CI, lower these so a flush fires deterministically:
#   AEGIS_SMOKE_CPU_THRESHOLD=50
#   AEGIS_SMOKE_MEM_THRESHOLD=50
#   AEGIS_SMOKE_MIN_CONSECUTIVE=1
# AEGIS_CPU_ANOMALY_THRESHOLD=95
# AEGIS_MEM_ANOMALY_THRESHOLD=90
# AEGIS_ANOMALY_MIN_CONSECUTIVE=3
